{
  "name": "logo",
  "version": "1.0.0",
  "description": "Local Vue 3 project development system",
  "author": "王振 <rememberwz@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "node --watch ./server/app.js",
    "start": "node ./server/app.js",
    "test": "npm run build:ui && node --test test/*.test.js",
    "build:ui": "npm --prefix server/src/app run build",
    "dev:ui": "npm --prefix server/src/app run dev",
    "test:ui": "npm run build:ui && node --test test/ui-vue3.test.js",
    "audit": "npm audit && npm --prefix server/src/app audit",
    "audit:production": "npm audit --omit=dev && npm --prefix server/src/app audit --omit=dev"
  },
  "dependencies": {
    "koa": "^2.1.0",
    "koa-router": "^7.0.1",
    "koa-static": "^3.0.0",
    "mysql2": "3.24.6",
    "opn": "^4.0.2",
    "qiniu": "7.15.2",
    "semver": "^5.3.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@vue/compiler-sfc": "3.5.44",
    "babel-loader": "9.2.1",
    "chalk": "^1.1.3",
    "connect-history-api-fallback": "^2.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "express": "^4.14.1",
    "html-webpack-plugin": "5.6.8",
    "http-proxy-middleware": "3.0.10",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "ora": "^1.1.0",
    "style-loader": "4.0.0",
    "vue-loader": "17.4.2",
    "webpack": "5.112.2",
    "webpack-dev-middleware": "7.4.6",
    "webpack-hot-middleware": "2.26.1",
    "webpack-merge": "6.0.1"
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ]
}
